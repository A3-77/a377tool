# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Node ----
node_modules/
package-lock.json

# ---- WorkBuddy 工作区数据（含会话记忆，不公开）----
.workbuddy-ai/

# ---- 测试产物 ----
tests/*.log
tests/render_*.png
tests/render_*.jpg
tests/js_*.mp3
tests/js_*.flac
tests/_*.mjs
tests/web_*.pdf
tests/web_*.zip
tests/thumbs_*.zip
tests/merged_*.pdf
tests/out_*
# 皮肤对照图的生成产物（跑 tests/skin-compare/gen.mjs 得到）
tests/skin-compare/shots/
tests/skin-compare/index.html

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥 / 本地开发变量 ----
# wrangler 的本地环境变量文件，里面是 SESSION_SECRET / ADMIN_TOKEN 明文，绝不能提交
.dev.vars
.dev.vars.*
!.dev.vars.example
web/.d1dev/
# wrangler 自己的本地缓存（每次 pages dev 都会重建）
.wrangler/
web/.wrangler/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 备份产物（快照不进版本控制，避免自我引用）----
backup-*/
backup-*.zip
